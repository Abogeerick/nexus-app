# Database (Supabase PostgreSQL)
# Get this from: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# Authentication (NextAuth.js v5)
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Generate this with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-min-32-characters-long"
AUTH_SECRET="your-secret-key-min-32-characters-long"

# JWT Configuration
JWT_SECRET="your-jwt-secret-key-for-refresh-tokens"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Email (Gmail SMTP or Mailtrap)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@nexusfinance.app"

# External APIs (Free Tiers)
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
FINNHUB_API_KEY="your-free-finnhub-key"
ALPHA_VANTAGE_API_KEY="your-free-alpha-vantage-key"
EXCHANGE_RATE_API_URL="https://api.exchangerate.host"

# Optional: Future Paid Services
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""

